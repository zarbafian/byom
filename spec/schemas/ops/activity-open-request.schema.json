{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/activity-open-request.schema.json",
  "title": "BPP activity_open request (DESIGN.md §11.1, §14.8; registry R29 participant)",
  "description": "Mutation (meta required). Opens an ActivityStream owned by the Participant, not by Byom's scheduler; activity does not require a pre-existing obligation, but every non-pledged stream still has an exact purpose, classification, Mandate, budget, rate, and retention boundary and may not claim a beneficiary or completion (§11.1). pledge_binding makes it a PledgeWorkstream. Field names verbatim from the §11.1 record shape; activity_stream_id, participant_ref, generation, revision, continuation_head_*, journal_cursor, state, and created_at are server-derived (§14.3). Stage-capable (R29: stage only for activity proposal).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "op",
    "meta",
    "kind",
    "purpose_ref",
    "purpose_digest",
    "mandate_refs",
    "budget_account_set_ref"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/protocolVersion"
    },
    "op": {
      "const": "activity_open"
    },
    "meta": {
      "$ref": "#/$defs/mutationMeta"
    },
    "kind": {
      "enum": [
        "pledge_work",
        "exploration",
        "deliberation",
        "monitoring",
        "relationship",
        "learning",
        "negotiation"
      ]
    },
    "purpose_ref": {
      "$ref": "#/$defs/identifier"
    },
    "purpose_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "pledge_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pledge_id",
        "pledge_revision",
        "terms_digest"
      ],
      "properties": {
        "pledge_id": {
          "$ref": "#/$defs/identifier"
        },
        "pledge_revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "terms_digest": {
          "$ref": "#/$defs/digestRef"
        }
      },
      "description": "Exact committed-obligation binding (§11.1 ActivityStream shape)."
    },
    "activation_policy_ref": {
      "$ref": "#/$defs/identifier"
    },
    "activation_policy_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "mandate_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "budget_account_set_ref": {
      "$ref": "#/$defs/identifier"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value"
      ],
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class per the §14.2 table; substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex digest bytes."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for keyed classes (raw HMAC keys and per-object salts are never part of a DigestRef)."
        }
      },
      "description": "Typed DigestRef (§14.2): every digest field is typed, never an unlabelled hash."
    },
    "mutationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "expected_endpoint_incarnation",
        "expected_recovery_epoch"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/identifier"
        },
        "expected_endpoint_incarnation": {
          "$ref": "#/$defs/identifier"
        },
        "expected_recovery_epoch": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "expected_revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "causation_event_ref": {
          "$ref": "#/$defs/identifier"
        },
        "correlation_ref": {
          "$ref": "#/$defs/identifier"
        }
      },
      "description": "MutationMeta (§14.2). Required on every mutation; update operations additionally supply expected_revision (registry rule enforced in code, not expressible here)."
    }
  }
}
