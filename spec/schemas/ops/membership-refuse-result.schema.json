{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/membership-refuse-result.schema.json",
  "title": "BPP membership_refuse result (DESIGN.md §7.4; registry R11 candidate)",
  "description": "Success.result for membership_refuse: the immutable refusal receipt. An exact retry returns this same receipt; no terminal offer can later admit (§7.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refusal_id",
    "offer_ref",
    "offer_state",
    "fence_epoch",
    "refused_at",
    "digest"
  ],
  "properties": {
    "refusal_id": {
      "$ref": "#/$defs/identifier"
    },
    "offer_ref": {
      "$ref": "#/$defs/identifier"
    },
    "offer_state": {
      "const": "refused"
    },
    "onboarding_ref": {
      "$ref": "#/$defs/identifier"
    },
    "onboarding_state": {
      "const": "refused"
    },
    "superseded_acceptance_ref": {
      "$ref": "#/$defs/identifier"
    },
    "fence_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "refused_at": {
      "$ref": "#/$defs/timestamp"
    },
    "digest": {
      "$ref": "#/$defs/digestRef"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value"
      ],
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class per the §14.2 table; substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex digest bytes."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for keyed classes (raw HMAC keys and per-object salts are never part of a DigestRef)."
        }
      },
      "description": "Typed DigestRef (§14.2): every digest field is typed, never an unlabelled hash."
    }
  }
}
