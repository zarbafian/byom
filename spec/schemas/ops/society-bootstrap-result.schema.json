{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/society-bootstrap-result.schema.json",
  "title": "BPP society_bootstrap result (DESIGN.md §6.1, §14.8; registry R2 governance)",
  "description": "Success.result for society_bootstrap: the active Society record (§6.1 shape) plus the genesis event reference (gap note G1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "society_id",
    "revision",
    "home_authority_ref",
    "charter_head_ref",
    "charter_head_digest",
    "classification_binding_ref",
    "classification_binding_digest",
    "root_budget_account_set_ref",
    "recovery_epoch",
    "state",
    "created_at",
    "genesis_event_ref"
  ],
  "properties": {
    "society_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "home_authority_ref": {
      "$ref": "#/$defs/identifier"
    },
    "kovee_realm_binding": {
      "$ref": "#/$defs/identifier"
    },
    "kovee_project_binding": {
      "$ref": "#/$defs/identifier"
    },
    "charter_head_ref": {
      "$ref": "#/$defs/identifier"
    },
    "charter_head_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "classification_binding_ref": {
      "$ref": "#/$defs/identifier"
    },
    "classification_binding_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "root_budget_account_set_ref": {
      "$ref": "#/$defs/identifier"
    },
    "recovery_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "state": {
      "const": "active"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "genesis_event_ref": {
      "$ref": "#/$defs/identifier"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "algorithm", "value_hex"],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md §6.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md §6, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": { "enum": ["sha-256", "hmac-sha-256"] },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": { "const": "sha-256" }
          },
          "not": { "required": ["key_ref"] }
        },
        {
          "properties": {
            "class": { "enum": ["local_erasure_safe", "scope_erasure_safe"] },
            "algorithm": { "const": "hmac-sha-256" }
          },
          "required": ["key_ref"]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    }
  }
}
