{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/effect-outcome-admit-request.schema.json",
  "title": "BPP effect_outcome_admit request (DESIGN.md \u00a713.1, \u00a713.2; registry R35 runtime)",
  "description": "Mutation (meta required, create-classed: it appends an immutable EffectOutcomeAdmission revision and CASes its own head). SOURCE FACTS ONLY \u2014 this path has NO GovernanceDecision member at all. Byom verifies the exact source revision and never rewrites the host Effect or receipt. An ambiguous-to-final path must cite `reconciles_admission_*`; an ambiguous arm carries no result and reconciles nothing. Both fences are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "op",
    "meta",
    "episode_ref",
    "generation",
    "byom_attempt_ref",
    "byom_fence_epoch",
    "kovee_invocation_fence",
    "intent_ref",
    "intent_digest",
    "stable_execution_key",
    "host_protocol",
    "host_endpoint_ref",
    "host_effect_ref",
    "host_effect_digest",
    "host_receipt_ref",
    "host_receipt_digest",
    "host_cursor_or_signature_ref",
    "verification_status",
    "outcome"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/protocolVersion"
    },
    "op": {
      "const": "effect_outcome_admit"
    },
    "meta": {
      "$ref": "#/$defs/mutationMeta"
    },
    "episode_ref": {
      "$ref": "#/$defs/identifier"
    },
    "generation": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "byom_attempt_ref": {
      "$ref": "#/$defs/identifier"
    },
    "byom_fence_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "kovee_invocation_fence": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "intent_ref": {
      "$ref": "#/$defs/identifier"
    },
    "intent_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "stable_execution_key": {
      "$ref": "#/$defs/identifier"
    },
    "host_protocol": {
      "const": "kovee"
    },
    "host_endpoint_ref": {
      "$ref": "#/$defs/identifier"
    },
    "host_effect_ref": {
      "$ref": "#/$defs/identifier"
    },
    "host_effect_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "host_receipt_ref": {
      "$ref": "#/$defs/identifier"
    },
    "host_receipt_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "host_cursor_or_signature_ref": {
      "$ref": "#/$defs/identifier"
    },
    "verification_status": {
      "const": "verified",
      "description": "Byom admits an EffectOutcomeAdmission only from a VERIFIED source revision (\u00a713.2)."
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "ambiguous"
      ]
    },
    "result_ref": {
      "$ref": "#/$defs/identifier"
    },
    "result_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "usage_settlement_ref": {
      "$ref": "#/$defs/identifier"
    },
    "reconciles_admission_ref": {
      "$ref": "#/$defs/identifier"
    },
    "reconciles_admission_digest": {
      "$ref": "#/$defs/digestRef"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (\u00a714.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (\u00a714.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (\u00a714.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset, semantically valid in the proleptic Gregorian calendar: the pattern pins the lexical ranges and implementations MUST additionally reject impossible calendar instants (e.g. 2026-02-30) \u2014 the conformance runner enforces this on every vector; leap seconds are not accepted. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3, amended per RT-17)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value_hex"
      ],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md \u00a76.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md \u00a76, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": {
              "const": "sha-256"
            }
          },
          "not": {
            "required": [
              "key_ref"
            ]
          }
        },
        {
          "properties": {
            "class": {
              "enum": [
                "local_erasure_safe",
                "scope_erasure_safe"
              ]
            },
            "algorithm": {
              "const": "hmac-sha-256"
            }
          },
          "required": [
            "key_ref"
          ]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    },
    "mutationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "expected_endpoint_incarnation",
        "expected_recovery_epoch"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/identifier"
        },
        "expected_endpoint_incarnation": {
          "$ref": "#/$defs/identifier"
        },
        "expected_recovery_epoch": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "causation_event_ref": {
          "$ref": "#/$defs/identifier"
        },
        "correlation_ref": {
          "$ref": "#/$defs/identifier"
        }
      },
      "description": "MutationMeta (\u00a714.2), create-classed: this operation creates a record (or CASes a subordinate head through its own body fields), so the closed create meta carries NO expected_revision member \u2014 supplying one fails the closed schema (RT-01: update CAS is structural, never optional)."
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "ambiguous"
        },
        "result_ref": false,
        "result_digest": false,
        "reconciles_admission_ref": false,
        "reconciles_admission_digest": false
      },
      "$comment": "An ambiguous source admission carries no result and reconciles nothing (\u00a713.2); it is genesis-only by that closure."
    },
    {
      "required": [
        "result_ref",
        "result_digest",
        "reconciles_admission_ref",
        "reconciles_admission_digest"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        }
      },
      "$comment": "Final successor with a verified result."
    },
    {
      "required": [
        "result_ref",
        "result_digest"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "reconciles_admission_ref": false,
        "reconciles_admission_digest": false
      },
      "$comment": "Final genesis with a verified result."
    },
    {
      "required": [
        "reconciles_admission_ref",
        "reconciles_admission_digest"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "result_ref": false,
        "result_digest": false
      },
      "$comment": "Final successor with no verified result."
    },
    {
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "result_ref": false,
        "result_digest": false,
        "reconciles_admission_ref": false,
        "reconciles_admission_digest": false
      },
      "$comment": "Final genesis with no verified result."
    }
  ],
  "$comment": "Ref/digest groups are all-or-none, so the arms enumerate the admissible presence combinations; a half pair matches no arm."
}
