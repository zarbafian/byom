{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/act-intent-prepare-result.schema.json",
  "title": "BPP act_intent_prepare result (DESIGN.md §13.1, §10.5, §14.8; registry R19 participant)",
  "description": "Success.result for act_intent_prepare (§13.1 ActIntent record projection; gap notes G4/G34) with the field-complete PreparationTrace embedded verbatim (§10.5, R19 fence). required_seat_refs are the server-prepared seats for the position stage (§14.6, derived name — gap note G34). preconditions are typed records pending the C2 act-class taxonomy (open objects, G10 precedent).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "revision",
    "state",
    "kind",
    "execution_kind",
    "requested_by_participant",
    "subject_ref",
    "subject_revision",
    "subject_digest",
    "preconditions",
    "mandate_ref",
    "mandate_revision",
    "mandate_digest",
    "preparation_trace",
    "authorization_dependency_set_ref",
    "dependency_digest",
    "stable_execution_key",
    "required_seat_refs",
    "expires_at"
  ],
  "properties": {
    "intent_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "state": {
      "enum": [
        "prepared"
      ]
    },
    "kind": {
      "$ref": "#/$defs/identifier"
    },
    "execution_kind": {
      "enum": [
        "domain_transition",
        "external_effect"
      ]
    },
    "requested_by_participant": {
      "$ref": "#/$defs/identifier"
    },
    "endeavor_ref": {
      "$ref": "#/$defs/identifier"
    },
    "pledge_ref": {
      "$ref": "#/$defs/identifier"
    },
    "subject_ref": {
      "$ref": "#/$defs/identifier"
    },
    "subject_revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "subject_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "preconditions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "description": "Typed precondition pending the Δ4/C2 act-class taxonomy; gap note G34."
      }
    },
    "context_manifest_ref": {
      "$ref": "#/$defs/identifier"
    },
    "context_manifest_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "disclosure_manifest_ref": {
      "$ref": "#/$defs/identifier"
    },
    "disclosure_manifest_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "driver_audience": {
      "$ref": "#/$defs/identifier"
    },
    "budget_reservation_set_ref": {
      "$ref": "#/$defs/identifier"
    },
    "mandate_ref": {
      "$ref": "#/$defs/identifier"
    },
    "mandate_revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "mandate_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "preparation_trace": {
      "$ref": "#/$defs/preparationTrace"
    },
    "authorization_dependency_set_ref": {
      "$ref": "#/$defs/identifier"
    },
    "dependency_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "stable_execution_key": {
      "$ref": "#/$defs/identifier"
    },
    "required_seat_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "algorithm", "value_hex"],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md §6.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md §6, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": { "enum": ["sha-256", "hmac-sha-256"] },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": { "const": "sha-256" }
          },
          "not": { "required": ["key_ref"] }
        },
        {
          "properties": {
            "class": { "enum": ["local_erasure_safe", "scope_erasure_safe"] },
            "algorithm": { "const": "hmac-sha-256" }
          },
          "required": ["key_ref"]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    },
    "preparationTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "operation",
        "actor_binding_ref",
        "input_ref",
        "input_digest",
        "output_subject_digest",
        "field_sources",
        "policy_algebra_version",
        "dependency_set_ref",
        "created_at",
        "digest"
      ],
      "properties": {
        "trace_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "actor_binding_ref": {
          "$ref": "#/$defs/identifier"
        },
        "input_ref": {
          "$ref": "#/$defs/identifier"
        },
        "input_digest": {
          "$ref": "#/$defs/digestRef"
        },
        "output_subject_digest": {
          "$ref": "#/$defs/digestRef"
        },
        "field_sources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "output_pointer",
              "source_ref",
              "source_pointer",
              "transform_id"
            ],
            "properties": {
              "output_pointer": {
                "$ref": "#/$defs/jsonPointer"
              },
              "source_ref": {
                "$ref": "#/$defs/identifier"
              },
              "source_pointer": {
                "$ref": "#/$defs/jsonPointer"
              },
              "transform_id": {
                "$ref": "#/$defs/identifier"
              }
            }
          },
          "description": "Every mechanical normalization, intersection, pinned-collection expansion, or derived total names its transform id and source fields (§10.5)."
        },
        "policy_algebra_version": {
          "$ref": "#/$defs/identifier"
        },
        "dependency_set_ref": {
          "$ref": "#/$defs/identifier"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "digest": {
          "$ref": "#/$defs/digestRef"
        }
      },
      "description": "Field-complete PreparationTrace, verbatim §10.5 (R19). Preparation never supplies a semantic default, guesses a recipient, chooses a reviewer, decomposes a goal, or uses a model."
    },
    "jsonPointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "JSON pointer into the prepared subject or its source (§10.5 field_sources)."
    }
  }
}
