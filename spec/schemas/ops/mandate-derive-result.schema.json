{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/mandate-derive-result.schema.json",
  "title": "BPP mandate_derive result (DESIGN.md §10.1, §10.2, §14.8; registry R15 participant)",
  "description": "Success.result for mandate_derive (gap notes G4/G30/G33): the prepared child Mandate subject with its exact parent pin and PreparationTrace linkage. Issuance still goes through mandate_issue (§14.8: prepared/positions → active / issue).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_id",
    "revision",
    "state",
    "parent_mandate_ref",
    "parent_mandate_revision",
    "parent_mandate_digest",
    "subject_digest",
    "preparation_trace_ref",
    "preparation_trace_digest",
    "required_seat_refs",
    "dependency_set_ref",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "mandate_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "state": {
      "enum": [
        "prepared"
      ]
    },
    "parent_mandate_ref": {
      "$ref": "#/$defs/identifier"
    },
    "parent_mandate_revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "parent_mandate_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "subject_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "preparation_trace_ref": {
      "$ref": "#/$defs/identifier"
    },
    "preparation_trace_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "required_seat_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "dependency_set_ref": {
      "$ref": "#/$defs/identifier"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value"
      ],
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class per the §14.2 table; substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex digest bytes."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for keyed classes (raw HMAC keys and per-object salts are never part of a DigestRef)."
        }
      },
      "description": "Typed DigestRef (§14.2): every digest field is typed, never an unlabelled hash."
    }
  }
}
