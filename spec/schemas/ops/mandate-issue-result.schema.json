{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/mandate-issue-result.schema.json",
  "title": "BPP mandate_issue result (DESIGN.md §10.1, §14.8; registry R18 governance)",
  "description": "Success.result for mandate_issue (§10.1 Mandate record projection; gap notes G4/G31/G32). A Mandate is never delivered as a reusable bearer credential: each consequential use goes through act_intent_prepare and execution_permit_consume (§10.1, §13.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_id",
    "revision",
    "state",
    "issuer_ref",
    "grantee_participant_ref",
    "purpose_ref",
    "purpose_digest",
    "allowed_operations",
    "resource_selectors",
    "data_class_selectors",
    "destination_selectors",
    "budget_ceiling_set_ref",
    "concurrency_ceiling",
    "delegation",
    "decision_refs",
    "decision_slot_snapshot_digests",
    "root_authority_trace_digest",
    "dependency_set_ref",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "mandate_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "state": {
      "enum": [
        "active"
      ]
    },
    "issuer_ref": {
      "$ref": "#/$defs/identifier"
    },
    "grantee_participant_ref": {
      "$ref": "#/$defs/identifier"
    },
    "purpose_ref": {
      "$ref": "#/$defs/identifier"
    },
    "purpose_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "resource_selectors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "data_class_selectors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "destination_selectors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "context_ceiling_ref": {
      "$ref": "#/$defs/identifier"
    },
    "budget_ceiling_set_ref": {
      "$ref": "#/$defs/identifier"
    },
    "concurrency_ceiling": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "manifestation_selector": {
      "type": "object",
      "description": "Opaque body pending the BPA-1 policy-algebra slice (ADR-0001); gap note G10."
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "parent_mandate_ref": {
      "$ref": "#/$defs/identifier",
      "description": "Present exactly on a derived child (gap note G33)."
    },
    "decision_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "decision_slot_snapshot_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/digestRef"
      }
    },
    "root_authority_trace_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "dependency_set_ref": {
      "$ref": "#/$defs/identifier"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value"
      ],
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class per the §14.2 table; substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex digest bytes."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for keyed classes (raw HMAC keys and per-object salts are never part of a DigestRef)."
        }
      },
      "description": "Typed DigestRef (§14.2): every digest field is typed, never an unlabelled hash."
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "max_depth",
        "max_children",
        "grantee_selectors"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_depth": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "max_children": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "grantee_selectors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "description": "Identifier array referencing selector definitions (gap note G10/G31)."
        }
      },
      "description": "Verbatim §10.1 delegation ceiling; a child Mandate can never exceed it (§10.2)."
    }
  }
}
