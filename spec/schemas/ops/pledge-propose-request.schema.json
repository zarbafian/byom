{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/pledge-propose-request.schema.json",
  "title": "BPP pledge_propose request (DESIGN.md §9.3, §14.8; registry R5 participant)",
  "description": "Mutation (meta required). Proposes a Pledge (a new PledgeProposal). Field names verbatim from the §9.3 record shape; proposal_id, terms_digest, required_slots, and state are server-prepared (§14.6: the server prepares canonical subjects and required seats), and amendment_of never appears here — amendments go through pledge_amend (gap note G23). budget_request_set, allowed_manifestation_selector, delegation_ceiling, and cancellation_terms are opaque pending BPA-1 — gap note G10. Stage-capable (R5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "op",
    "meta",
    "endeavor_id",
    "proposed_pledgor_ref",
    "beneficiary_ref",
    "exact_outcome_schema_refs",
    "acceptance_criteria_refs",
    "evidence_requirements",
    "reviewer_rule_ref",
    "input_context_ref",
    "input_context_digest",
    "budget_request_set",
    "allowed_manifestation_selector",
    "delegation_ceiling",
    "deadline",
    "cancellation_terms",
    "dependency_refs"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/protocolVersion"
    },
    "op": {
      "const": "pledge_propose"
    },
    "meta": {
      "$ref": "#/$defs/mutationMeta"
    },
    "endeavor_id": {
      "$ref": "#/$defs/identifier"
    },
    "call_ref": {
      "$ref": "#/$defs/identifier"
    },
    "proposed_pledgor_ref": {
      "$ref": "#/$defs/identifier"
    },
    "beneficiary_ref": {
      "$ref": "#/$defs/identifier"
    },
    "exact_outcome_schema_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "acceptance_criteria_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "reviewer_rule_ref": {
      "$ref": "#/$defs/identifier"
    },
    "input_context_ref": {
      "$ref": "#/$defs/identifier"
    },
    "input_context_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "budget_request_set": {
      "type": "object",
      "description": "Opaque body pending the BPA-1 policy-algebra slice (ADR-0001); gap note G10."
    },
    "disclosure_manifest_ref": {
      "$ref": "#/$defs/identifier"
    },
    "allowed_manifestation_selector": {
      "type": "object",
      "description": "Opaque body pending the BPA-1 policy-algebra slice (ADR-0001); gap note G10."
    },
    "delegation_ceiling": {
      "type": "object",
      "description": "Opaque body pending the BPA-1 policy-algebra slice (ADR-0001); gap note G10."
    },
    "deadline": {
      "$ref": "#/$defs/timestamp"
    },
    "cancellation_terms": {
      "type": "object",
      "description": "Opaque body pending the BPA-1 policy-algebra slice (ADR-0001); gap note G10."
    },
    "dependency_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value"
      ],
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class per the §14.2 table; substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex digest bytes."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for keyed classes (raw HMAC keys and per-object salts are never part of a DigestRef)."
        }
      },
      "description": "Typed DigestRef (§14.2): every digest field is typed, never an unlabelled hash."
    },
    "mutationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "expected_endpoint_incarnation",
        "expected_recovery_epoch"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/identifier"
        },
        "expected_endpoint_incarnation": {
          "$ref": "#/$defs/identifier"
        },
        "expected_recovery_epoch": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "expected_revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "causation_event_ref": {
          "$ref": "#/$defs/identifier"
        },
        "correlation_ref": {
          "$ref": "#/$defs/identifier"
        }
      },
      "description": "MutationMeta (§14.2). Required on every mutation; update operations additionally supply expected_revision (registry rule enforced in code, not expressible here)."
    }
  }
}
