{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/ops/manifestation-propose-request.schema.json",
  "title": "BPP manifestation_propose request (DESIGN.md §7.2; registry R13 participant)",
  "description": "Mutation (meta required). Proposes a ManifestationRevision for the owning Participant (sender-constrained channel and binding epoch, R13). A package, model, adapter, controller, or material security-profile change creates a new revision; no update silently inherits authority (§7.2). Field names verbatim from the record shape; manifestation_id, participant_id, revision, status, and digest are server-derived.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "op",
    "meta",
    "host_kind",
    "host_binding_ref",
    "package_or_adapter_digest",
    "supported_protocol_versions",
    "feature_set",
    "input_and_output_schema_refs",
    "requested_security_profiles",
    "controller_domain_ref",
    "concurrency_limit"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/protocolVersion"
    },
    "op": {
      "const": "manifestation_propose"
    },
    "meta": {
      "$ref": "#/$defs/mutationMeta"
    },
    "host_kind": {
      "enum": [
        "kovee_deployment",
        "attached_harness",
        "external_runtime",
        "collective_executor"
      ]
    },
    "host_binding_ref": {
      "$ref": "#/$defs/identifier"
    },
    "package_or_adapter_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "supported_protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/protocolVersion"
      }
    },
    "feature_set": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "input_and_output_schema_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "requested_security_profiles": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "observed_assurance_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "controller_domain_ref": {
      "$ref": "#/$defs/identifier"
    },
    "concurrency_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Positive concurrency ceiling (§7.2)."
    },
    "previous_digest": {
      "$ref": "#/$defs/digestRef",
      "description": "Prior revision digest when superseding (§7.2 revision chain)."
    }
  },
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Negotiated protocol minor version, e.g. \"0.2\" (§14.1)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "algorithm", "value_hex"],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md §6.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md §6, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": { "enum": ["sha-256", "hmac-sha-256"] },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": { "const": "sha-256" }
          },
          "not": { "required": ["key_ref"] }
        },
        {
          "properties": {
            "class": { "enum": ["local_erasure_safe", "scope_erasure_safe"] },
            "algorithm": { "const": "hmac-sha-256" }
          },
          "required": ["key_ref"]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    },
    "mutationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "expected_endpoint_incarnation",
        "expected_recovery_epoch"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/identifier"
        },
        "expected_endpoint_incarnation": {
          "$ref": "#/$defs/identifier"
        },
        "expected_recovery_epoch": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "expected_revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "causation_event_ref": {
          "$ref": "#/$defs/identifier"
        },
        "correlation_ref": {
          "$ref": "#/$defs/identifier"
        }
      },
      "description": "MutationMeta (§14.2). Required on every mutation; update operations additionally supply expected_revision (registry rule enforced in code, not expressible here)."
    }
  }
}
