{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/protocol-info-result.schema.json",
  "title": "BPP protocol_info result (DESIGN.md §14.1, §14.9): supported versions and revisioned protocol limits",
  "description": "The Success.result payload for op protocol_info: the server's supported protocol minor versions and its conformance-tested, revisioned initial limits (§14.9 — request 256 KiB, response 1 MiB, identifiers 128 bytes, 256 list items per mutation, 512 events per page). DESIGN.md §14 does not enumerate these result fields; they are the minimal design-derived set and freeze with the bundle registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versions", "limits", "limits_revision"],
  "properties": {
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_bytes_max",
        "response_bytes_max",
        "identifier_bytes_max",
        "mutation_list_items_max",
        "events_page_items_max"
      ],
      "properties": {
        "request_bytes_max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "response_bytes_max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "identifier_bytes_max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "mutation_list_items_max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "events_page_items_max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "limits_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
