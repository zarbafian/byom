{
  "name": "machines/episode-lease-crash-reclaim",
  "description": "EpisodeLeaseHead walk under D-RT-6 (RT-10): claim, worker crash — which alone enables NOTHING (the immediate re-claim is a rejected row) — then authoritative-time expiry (server_time past the lease deadline), re-claim under a fresh fence from lease_expired only, yield/re-claim, completion settling terminal; a terminal head cannot restart (§11.2).",
  "input": {
    "machine": "episode",
    "steps": [
      {
        "from": "absent",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "accepted"
      },
      {
        "crash": true
      },
      {
        "from": "lease_leased",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "rejected"
      },
      {
        "from": "lease_leased",
        "via": "server_time",
        "to": "lease_expired",
        "expect": "accepted"
      },
      {
        "from": "lease_expired",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "accepted"
      },
      {
        "from": "lease_leased",
        "via": "episode_start",
        "to": "lease_running",
        "expect": "accepted"
      },
      {
        "from": "lease_running",
        "via": "episode_yield",
        "to": "lease_yielding",
        "expect": "accepted"
      },
      {
        "from": "lease_yielding",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "accepted"
      },
      {
        "from": "lease_leased",
        "via": "episode_start",
        "to": "lease_running",
        "expect": "accepted"
      },
      {
        "from": "lease_running",
        "via": "episode_complete",
        "to": "lease_completing",
        "expect": "accepted"
      },
      {
        "crash": true
      },
      {
        "from": "lease_completing",
        "via": "episode_complete",
        "to": "lease_terminal",
        "expect": "accepted"
      },
      {
        "from": "lease_terminal",
        "via": "episode_start",
        "to": "lease_running",
        "expect": "rejected"
      }
    ]
  },
  "expected": {
    "final_state": "lease_terminal"
  }
}
