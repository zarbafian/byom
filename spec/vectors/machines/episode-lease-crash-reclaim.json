{
  "name": "machines/episode-lease-crash-reclaim",
  "description": "EpisodeLeaseHead walk (folded lease states, G29): claim, worker crash, expired-head re-claim under a fresh fence (a real transition, not a replay), yield/re-claim, completion settling terminal; a terminal head cannot restart (section 11.2).",
  "input": {
    "machine": "episode",
    "steps": [
      {
        "from": "absent",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "accepted"
      },
      {
        "crash": true
      },
      {
        "from": "lease_leased",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "accepted"
      },
      {
        "from": "lease_leased",
        "via": "episode_start",
        "to": "lease_running",
        "expect": "accepted"
      },
      {
        "from": "lease_running",
        "via": "episode_yield",
        "to": "lease_yielding",
        "expect": "accepted"
      },
      {
        "from": "lease_yielding",
        "via": "episode_claim",
        "to": "lease_leased",
        "expect": "accepted"
      },
      {
        "from": "lease_leased",
        "via": "episode_start",
        "to": "lease_running",
        "expect": "accepted"
      },
      {
        "from": "lease_running",
        "via": "episode_complete",
        "to": "lease_completing",
        "expect": "accepted"
      },
      {
        "crash": true
      },
      {
        "from": "lease_completing",
        "via": "episode_complete",
        "to": "lease_terminal",
        "expect": "accepted"
      },
      {
        "from": "lease_terminal",
        "via": "episode_start",
        "to": "lease_running",
        "expect": "rejected"
      }
    ]
  },
  "expected": {
    "final_state": "lease_terminal"
  }
}
