{
  "name": "machines/pledge-amend-cas",
  "description": "Pledge amendment CAS under D-RT-3 (RT-03): pledge_amend NEVER supersedes the predecessor (rejected row) — supersession commits only when pledge_finalize accepts the successor's complete fresh seat set under the successor CAS; the finalize replay is a no-op, a competing relinquish finds no open state, and expiry cannot leave the terminal state (§9.5, §14.8).",
  "input": {
    "machine": "pledge",
    "steps": [
      {
        "from": "absent",
        "via": "pledge_propose",
        "to": "proposed",
        "expect": "accepted"
      },
      {
        "from": "proposed",
        "via": "pledge_position",
        "to": "proposed",
        "expect": "accepted"
      },
      {
        "from": "proposed",
        "via": "pledge_finalize",
        "to": "active",
        "expect": "accepted"
      },
      {
        "from": "active",
        "via": "pledge_amend",
        "to": "superseded",
        "expect": "rejected"
      },
      {
        "from": "active",
        "via": "pledge_finalize",
        "to": "superseded",
        "expect": "accepted"
      },
      {
        "from": "superseded",
        "via": "pledge_finalize",
        "to": "superseded",
        "expect": "replay"
      },
      {
        "crash": true
      },
      {
        "from": "superseded",
        "via": "pledge_relinquish",
        "to": "relinquished",
        "expect": "rejected"
      },
      {
        "from": "superseded",
        "via": "server_time",
        "to": "expired",
        "expect": "rejected"
      }
    ]
  },
  "expected": {
    "final_state": "superseded"
  }
}
