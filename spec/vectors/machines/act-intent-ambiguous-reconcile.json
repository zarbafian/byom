{
  "name": "machines/act-intent-ambiguous-reconcile",
  "description": "Ambiguous effect reconciliation: an unprovable non-idempotent effect stays ambiguous across a crash until the source-authoritative final admission; the final branch never reopens (section 13.1, section 14.8).",
  "input": {
    "machine": "act-intent",
    "steps": [
      {
        "from": "absent",
        "via": "act_intent_prepare",
        "to": "prepared",
        "expect": "accepted"
      },
      {
        "from": "prepared",
        "via": "act_intent_position",
        "to": "awaiting_decision",
        "expect": "accepted"
      },
      {
        "from": "awaiting_decision",
        "via": "act_intent_finalize",
        "to": "authorized",
        "expect": "accepted"
      },
      {
        "from": "authorized",
        "via": "execution_permit_consume",
        "to": "consumed",
        "expect": "accepted"
      },
      {
        "from": "consumed",
        "via": "host_effect_attempt",
        "to": "executing",
        "expect": "accepted"
      },
      {
        "from": "executing",
        "via": "effect_outcome_admit",
        "to": "ambiguous",
        "expect": "accepted"
      },
      {
        "crash": true
      },
      {
        "from": "ambiguous",
        "via": "host_effect_attempt",
        "to": "executing",
        "expect": "rejected"
      },
      {
        "from": "ambiguous",
        "via": "effect_outcome_admit",
        "to": "failed",
        "expect": "accepted"
      },
      {
        "from": "failed",
        "via": "effect_outcome_admit",
        "to": "succeeded",
        "expect": "rejected"
      }
    ]
  },
  "expected": {
    "final_state": "failed"
  }
}
