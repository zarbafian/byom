  "input": {
    "policy_op": "is_subset",
    "child": {
      "rules": [
        {
          "effect": "allow",
          "atoms": {
            "operation": {
              "ids": [
                "events_read"
              ]
            }
          }
        }
      ]
    },
    "parent": {
      "rules": []
    }
  },
  "expected": {
