{
  "name": "policy/subset-universal-parent-true",
  "description": "adversarial universal atom: any child is a subset of the universal allow rule (an empty atoms object constrains nothing)",
  "input": {
    "policy_op": "is_subset",
    "child": {
      "rules": [
        {
          "effect": "allow",
          "atoms": {
            "operation": {
              "ids": [
                "events_read"
              ]
            }
          }
        }
      ]
    },
    "parent": {
      "rules": [
        {
          "effect": "allow",
          "atoms": {}
        }
      ]
    }
  },
  "expected": {
    "result": {
      "ok": true,
      "subset": true
    }
  }
}
