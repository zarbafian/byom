{
  "name": "policy/subset-network-dns-vs-cidr-reject",
  "description": "is_subset typed rejection (never an exception, never false): a DNS host never compares to an IP/CIDR at policy level — DNS resolution is pinned by the broker, the algebra never resolves (§10.5)",
  "input": {
    "policy_op": "is_subset",
    "child": {
      "rules": [
        {
          "effect": "allow",
          "atoms": {
            "network_destination": {
              "scheme": "https",
              "host": {
                "dns": "api.example.com"
              },
              "ports": {
                "first": 443,
                "last": 443
              },
              "protocol": "tcp"
            }
          }
        }
      ]
    },
    "parent": {
      "rules": [
        {
          "effect": "allow",
          "atoms": {
            "network_destination": {
              "scheme": "https",
              "host": {
                "ip4_cidr": {
                  "octets": [
                    10,
                    0,
                    0,
                    0
                  ],
                  "prefix_len": 8
                }
              },
              "ports": {
                "first": 443,
                "last": 443
              },
              "protocol": "tcp"
            }
          }
        }
      ]
    }
  },
  "expected": {
    "result": {
      "ok": false,
      "error": {
        "kind": "incomparable",
        "where": "network_destination"
      }
    }
  }
}
