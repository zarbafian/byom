            "quantity": {
              "dimension": "money",
              "canonical_unit": "unit",
              "scale": 2,
              "max": 100,
              "currency": "USD",
              "pricing_revision": "pr-1"
            }
          }
        }
      ]
    },
    "b": {
      "rules": [
        {
          "effect": "allow",
          "atoms": {
            "quantity": {
              "dimension": "money",
              "canonical_unit": "unit",
              "scale": 2,
