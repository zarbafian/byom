{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/governed-work/byom-akson-dispatch-outcome-receipt.schema.json",
  "title": "ByomAksonDispatchOutcomeReceipt (DESIGN.md §17.2; §16.6 item 11; family contract L61–L64)",
  "description": "The §17.2 field list verbatim: Kovee's authoritative signed receipt for EVERY byom_akson_dispatch_v1 host outcome — a closed discriminated union over disposition pre_result_failed | ambiguous | verification_rejected | verified_result, encoded here as oneOf arms with per-arm required/forbidden members per §17.2's disposition table. Kovee owns the record and its head (family contract §1 ownership row; L64); this is the byom-normative shape byom verifies before admitting an EffectOutcomeAdmission — EOA fields are server-derived from this receipt, never copied from caller-selected values. Kovee commits every immutable successor and head CAS together BEFORE byom independently admits it (§16.6 item 11). Cross-member rules JSON Schema cannot express (increment-by-one, predecessor/reconciles digest equality, byte-equal chain identity against the named phases) are enforced in code and noted per member.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_revision",
    "disposition",
    "host_protocol",
    "driver_profile",
    "host_endpoint_ref",
    "kovee_effect_revision",
    "classification_profile",
    "source_endpoint_ref",
    "source_identity_epoch",
    "destination_endpoint_ref",
    "destination_identity_epoch",
    "request_classification_digest",
    "kovee_effect_ref",
    "kovee_effect_digest",
    "execution_consumption_receipt_ref",
    "execution_consumption_receipt_digest",
    "act_intent_ref",
    "act_intent_digest",
    "mandate_use_ref",
    "mandate_use_digest",
    "stable_execution_key",
    "delivery_key",
    "outcome",
    "observed_at",
    "kovee_service_signature_ref",
    "digest"
  ],
  "properties": {
    "receipt_id": {
      "$ref": "#/$defs/identifier"
    },
    "receipt_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Genesis is revision 1 with no predecessor; a successor is allowed only from an ambiguous head, keeps the same identity, and increments by exactly one (increment-by-one and predecessor-digest equality are enforced in code; UNIQUE(receipt_id, receipt_revision) and UNIQUE(kovee_effect_ref, receipt_revision) likewise)."
    },
    "previous_receipt_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "disposition": {
      "enum": [
        "pre_result_failed",
        "ambiguous",
        "verification_rejected",
        "verified_result"
      ],
      "description": "§17.2 verbatim: the closed discriminated union."
    },
    "host_protocol": {
      "const": "kovee",
      "description": "§17.2 verbatim."
    },
    "driver_profile": {
      "const": "byom_akson_dispatch_v1",
      "description": "§17.2 verbatim."
    },
    "host_endpoint_ref": {
      "$ref": "#/$defs/identifier"
    },
    "kovee_effect_revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "classification_profile": {
      "enum": [
        "society_mapped_round_trip",
        "akson_neutral_contract"
      ],
      "description": "§17.2 verbatim: one closed classification profile, byte-equal across the phase chain."
    },
    "source_endpoint_ref": {
      "$ref": "#/$defs/identifier"
    },
    "source_identity_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "destination_endpoint_ref": {
      "$ref": "#/$defs/identifier"
    },
    "destination_identity_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "request_classification_digest": {
      "$ref": "#/$defs/digestRef",
      "description": "Every disposition binds the exact request phase; chain identity (ActIntent, MandateUse, receipt, keys, endpoint roots) must be byte-equal to it — enforced in code (§17.2)."
    },
    "acceptance_classification_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "result_classification_digest": {
      "$ref": "#/$defs/digestRef",
      "description": "Only verified_result carries a result-classification digest (§17.2)."
    },
    "kovee_effect_ref": {
      "$ref": "#/$defs/identifier"
    },
    "kovee_effect_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "execution_consumption_receipt_ref": {
      "$ref": "#/$defs/identifier"
    },
    "execution_consumption_receipt_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "act_intent_ref": {
      "$ref": "#/$defs/identifier"
    },
    "act_intent_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "mandate_use_ref": {
      "$ref": "#/$defs/identifier"
    },
    "mandate_use_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "stable_execution_key": {
      "$ref": "#/$defs/identifier"
    },
    "delivery_key": {
      "$ref": "#/$defs/identifier"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "ambiguous"
      ],
      "description": "§17.2 verbatim; each union arm pins its allowed value(s)."
    },
    "failure_stage": {
      "enum": [
        "before_dispatch",
        "stage_rejected",
        "consent_rejected",
        "dispatch_definitively_rejected",
        "reconciled_no_result"
      ],
      "description": "§17.2 verbatim. pre_result_failed is legal only when signed Kovee/Akson evidence proves no accepted remote work/result can later emerge for the delivery key; a timeout, lost dispatch reply, known acceptance without a final result, or unverifiable rejection is ambiguous, never failed. dispatch_definitively_rejected requires Akson's durable idempotency/consent state proving the dispatch was not and cannot be consumed."
    },
    "failure_evidence_ref": {
      "$ref": "#/$defs/identifier"
    },
    "failure_evidence_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "ambiguity_stage": {
      "enum": [
        "dispatch_unknown",
        "result_unknown",
        "verification_unknown"
      ],
      "description": "§17.2 verbatim; a transient verifier failure is ambiguous with verification_unknown, never verification_rejected."
    },
    "ambiguity_evidence_ref": {
      "$ref": "#/$defs/identifier"
    },
    "ambiguity_evidence_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "verification_rejection_class": {
      "enum": [
        "signature_invalid",
        "identity_epoch_mismatch",
        "schema_invalid",
        "digest_mismatch",
        "evidence_invalid",
        "contract_mismatch"
      ],
      "description": "§17.2 verbatim."
    },
    "terminal_rejection_evidence_ref": {
      "$ref": "#/$defs/identifier"
    },
    "terminal_rejection_evidence_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "akson_contract_acceptance_ref": {
      "$ref": "#/$defs/identifier"
    },
    "akson_contract_acceptance_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "akson_result_manifest_ref": {
      "$ref": "#/$defs/identifier"
    },
    "akson_result_manifest_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "akson_verification_ref": {
      "$ref": "#/$defs/identifier"
    },
    "akson_verification_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "reconciles_host_receipt_ref": {
      "$ref": "#/$defs/identifier"
    },
    "reconciles_host_receipt_digest": {
      "$ref": "#/$defs/digestRef",
      "description": "Required exactly when a final verified_result, verification_rejected, or pre_result_failed/reconciled_no_result supersedes an ambiguous receipt; forbidden otherwise (§17.2). The successor names the current receipt digest as BOTH previous_receipt_digest and reconciles_host_receipt_digest (equality enforced in code)."
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "kovee_service_signature_ref": {
      "$ref": "#/$defs/identifier"
    },
    "digest": {
      "$ref": "#/$defs/digestRef"
    }
  },
  "oneOf": [
    {
      "properties": {
        "disposition": {
          "const": "pre_result_failed"
        },
        "outcome": {
          "const": "failed"
        },
        "ambiguity_stage": false,
        "ambiguity_evidence_ref": false,
        "ambiguity_evidence_digest": false,
        "verification_rejection_class": false,
        "terminal_rejection_evidence_ref": false,
        "terminal_rejection_evidence_digest": false,
        "akson_result_manifest_ref": false,
        "akson_result_manifest_digest": false,
        "akson_verification_ref": false,
        "akson_verification_digest": false,
        "result_classification_digest": false
      },
      "required": [
        "failure_stage",
        "failure_evidence_ref",
        "failure_evidence_digest"
      ],
      "oneOf": [
        {
          "properties": {
            "failure_stage": {
              "enum": [
                "before_dispatch",
                "stage_rejected",
                "consent_rejected",
                "dispatch_definitively_rejected"
              ]
            },
            "receipt_revision": {
              "const": 1
            },
            "previous_receipt_digest": false,
            "reconciles_host_receipt_ref": false,
            "reconciles_host_receipt_digest": false,
            "acceptance_classification_digest": false,
            "akson_contract_acceptance_ref": false,
            "akson_contract_acceptance_digest": false
          },
          "$comment": "Genesis pre-result failure: revision 1, no predecessor, no acceptance triple."
        },
        {
          "properties": {
            "receipt_revision": {
              "minimum": 2
            },
            "failure_stage": {
              "const": "reconciled_no_result"
            }
          },
          "required": [
            "previous_receipt_digest",
            "reconciles_host_receipt_ref",
            "reconciles_host_receipt_digest",
            "acceptance_classification_digest",
            "akson_contract_acceptance_ref",
            "akson_contract_acceptance_digest"
          ],
          "$comment": "reconciled_no_result supersedes an ambiguous receipt with a known acceptance: the triple is all present (§17.2)."
        },
        {
          "properties": {
            "receipt_revision": {
              "minimum": 2
            },
            "failure_stage": {
              "const": "reconciled_no_result"
            },
            "acceptance_classification_digest": false,
            "akson_contract_acceptance_ref": false,
            "akson_contract_acceptance_digest": false
          },
          "required": [
            "previous_receipt_digest",
            "reconciles_host_receipt_ref",
            "reconciles_host_receipt_digest"
          ],
          "$comment": "reconciled_no_result where no acceptance was ever observed (dispatch_unknown ambiguity): triple all absent."
        }
      ],
      "$comment": "pre_result_failed: request-phase digest, outcome failed, exact failure stage and signed failure evidence; asserts no classified result and creates no AksonByomAdmissionClassification (§17.2)."
    },
    {
      "properties": {
        "disposition": {
          "const": "ambiguous"
        },
        "outcome": {
          "const": "ambiguous"
        },
        "receipt_revision": {
          "const": 1
        },
        "previous_receipt_digest": false,
        "reconciles_host_receipt_ref": false,
        "reconciles_host_receipt_digest": false,
        "failure_stage": false,
        "failure_evidence_ref": false,
        "failure_evidence_digest": false,
        "verification_rejection_class": false,
        "terminal_rejection_evidence_ref": false,
        "terminal_rejection_evidence_digest": false,
        "akson_result_manifest_ref": false,
        "akson_result_manifest_digest": false,
        "akson_verification_ref": false,
        "akson_verification_digest": false,
        "result_classification_digest": false
      },
      "required": [
        "ambiguity_stage",
        "ambiguity_evidence_ref",
        "ambiguity_evidence_digest"
      ],
      "oneOf": [
        {
          "required": [
            "acceptance_classification_digest",
            "akson_contract_acceptance_ref",
            "akson_contract_acceptance_digest"
          ],
          "$comment": "A known acceptance triple may be present…"
        },
        {
          "properties": {
            "acceptance_classification_digest": false,
            "akson_contract_acceptance_ref": false,
            "akson_contract_acceptance_digest": false
          },
          "$comment": "…or all three are absent (§17.2)."
        }
      ],
      "$comment": "ambiguous: request-phase digest, outcome ambiguous, exact ambiguity stage and signed ambiguity evidence; asserts no final outcome. Ambiguous receipts are genesis-only (revision 1): every successor carries reconciles_host_receipt_* which the ambiguous arm forbids, so an ambiguity-stage change is not a successor — resolution is (§17.2 receipt revisioning)."
    },
    {
      "properties": {
        "disposition": {
          "const": "verification_rejected"
        },
        "outcome": {
          "const": "failed"
        },
        "failure_stage": false,
        "failure_evidence_ref": false,
        "failure_evidence_digest": false,
        "ambiguity_stage": false,
        "ambiguity_evidence_ref": false,
        "ambiguity_evidence_digest": false,
        "result_classification_digest": false
      },
      "required": [
        "akson_result_manifest_ref",
        "akson_result_manifest_digest",
        "akson_verification_ref",
        "akson_verification_digest",
        "verification_rejection_class",
        "terminal_rejection_evidence_ref",
        "terminal_rejection_evidence_digest"
      ],
      "oneOf": [
        {
          "properties": {
            "receipt_revision": {
              "const": 1
            },
            "previous_receipt_digest": false,
            "reconciles_host_receipt_ref": false,
            "reconciles_host_receipt_digest": false
          },
          "required": [
            "acceptance_classification_digest",
            "akson_contract_acceptance_ref",
            "akson_contract_acceptance_digest"
          ]
        },
        {
          "properties": {
            "receipt_revision": {
              "const": 1
            },
            "previous_receipt_digest": false,
            "reconciles_host_receipt_ref": false,
            "reconciles_host_receipt_digest": false,
            "acceptance_classification_digest": false,
            "akson_contract_acceptance_ref": false,
            "akson_contract_acceptance_digest": false
          }
        },
        {
          "properties": {
            "receipt_revision": {
              "minimum": 2
            }
          },
          "required": [
            "previous_receipt_digest",
            "reconciles_host_receipt_ref",
            "reconciles_host_receipt_digest",
            "acceptance_classification_digest",
            "akson_contract_acceptance_ref",
            "akson_contract_acceptance_digest"
          ]
        },
        {
          "properties": {
            "receipt_revision": {
              "minimum": 2
            },
            "acceptance_classification_digest": false,
            "akson_contract_acceptance_ref": false,
            "akson_contract_acceptance_digest": false
          },
          "required": [
            "previous_receipt_digest",
            "reconciles_host_receipt_ref",
            "reconciles_host_receipt_digest"
          ]
        }
      ],
      "$comment": "verification_rejected: outcome failed with the claimed result manifest, the exact negative Akson verification, a closed rejection class, and signed terminal-rejection evidence proving no valid replacement result can emerge for the delivery key; the claimed bytes stay evidence — no result-classification digest, no classification admission, no EOA result (§17.2). Acceptance triple all-or-none."
    },
    {
      "properties": {
        "disposition": {
          "const": "verified_result"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "failure_stage": false,
        "failure_evidence_ref": false,
        "failure_evidence_digest": false,
        "ambiguity_stage": false,
        "ambiguity_evidence_ref": false,
        "ambiguity_evidence_digest": false,
        "verification_rejection_class": false,
        "terminal_rejection_evidence_ref": false,
        "terminal_rejection_evidence_digest": false
      },
      "required": [
        "result_classification_digest",
        "acceptance_classification_digest",
        "akson_contract_acceptance_ref",
        "akson_contract_acceptance_digest",
        "akson_result_manifest_ref",
        "akson_result_manifest_digest",
        "akson_verification_ref",
        "akson_verification_digest"
      ],
      "oneOf": [
        {
          "properties": {
            "receipt_revision": {
              "const": 1
            },
            "previous_receipt_digest": false,
            "reconciles_host_receipt_ref": false,
            "reconciles_host_receipt_digest": false
          }
        },
        {
          "properties": {
            "receipt_revision": {
              "minimum": 2
            }
          },
          "required": [
            "previous_receipt_digest",
            "reconciles_host_receipt_ref",
            "reconciles_host_receipt_digest"
          ]
        }
      ],
      "$comment": "verified_result: request, acceptance and result phase digests; outcome succeeded | failed; exact Akson acceptance, result manifest and verification. The cited verification must cover destination endpoint root/identity epoch, delivery key, acceptance digest, result-classification digest, and result manifest digest (equalities enforced in code). Only this branch may create AksonByomAdmissionClassification."
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value_hex"
      ],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md §6.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md §6, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": {
              "const": "sha-256"
            }
          },
          "not": {
            "required": [
              "key_ref"
            ]
          }
        },
        {
          "properties": {
            "class": {
              "enum": [
                "local_erasure_safe",
                "scope_erasure_safe"
              ]
            },
            "algorithm": {
              "const": "hmac-sha-256"
            }
          },
          "required": [
            "key_ref"
          ]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    }
  }
}
