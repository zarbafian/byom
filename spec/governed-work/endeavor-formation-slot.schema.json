{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/governed-work/endeavor-formation-slot.schema.json",
  "title": "EndeavorFormationSlot (DESIGN.md §16.3 verbatim; uniqueness slot with generations; C2)",
  "description": "The §16.3 record verbatim. UNIQUE(realm_id, requested_by_principal, client_formation_key) WHERE state != released (enforced in code). Each recovery-machine row CASes intent and slot together under `generation`; changed semantic command bytes conflict and never reuse the generation. Only a pre-send cancel, a verified tombstone, a verified historically fenced absence, or a committed ExternalLink releases the slot; after an external call may have committed there is no timeout-based release (§16.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot_id",
    "realm_id",
    "requested_by_principal",
    "client_formation_key",
    "holder_formation_id",
    "generation",
    "revision",
    "society_ref",
    "society_recovery_epoch",
    "source_actor_binding_digest",
    "realm_byom_binding_ref",
    "realm_byom_binding_revision",
    "realm_byom_binding_epoch",
    "realm_byom_binding_digest",
    "canonical_byom_command_digest",
    "byom_command_idempotency_key",
    "idempotency_domain_digest",
    "state",
    "acquired_at",
    "digest"
  ],
  "properties": {
    "slot_id": {
      "$ref": "#/$defs/identifier"
    },
    "realm_id": {
      "$ref": "#/$defs/identifier"
    },
    "requested_by_principal": {
      "$ref": "#/$defs/identifier"
    },
    "client_formation_key": {
      "$ref": "#/$defs/identifier"
    },
    "holder_formation_id": {
      "$ref": "#/$defs/identifier"
    },
    "generation": {
      "$ref": "#/$defs/safeNonNegativeInteger",
      "description": "The slot generation every paired intent/slot CAS runs under (§16.3)."
    },
    "revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "society_ref": {
      "$ref": "#/$defs/identifier"
    },
    "society_recovery_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "source_actor_binding_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "realm_byom_binding_ref": {
      "$ref": "#/$defs/identifier"
    },
    "realm_byom_binding_revision": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "realm_byom_binding_epoch": {
      "$ref": "#/$defs/safeNonNegativeInteger"
    },
    "realm_byom_binding_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "canonical_byom_command_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "byom_command_idempotency_key": {
      "$ref": "#/$defs/identifier"
    },
    "idempotency_domain_digest": {
      "$ref": "#/$defs/idempotencyDomainDigest"
    },
    "state": {
      "enum": [
        "held",
        "submitting",
        "remote_unknown",
        "awaiting_principal",
        "byom_committed",
        "linking",
        "ambiguous",
        "released"
      ],
      "description": "§16.3 verbatim; pairs with the intent state through the closed recovery machine (held↔prepared, released↔canceled/linked, others 1:1)."
    },
    "byom_result_ref": {
      "$ref": "#/$defs/identifier"
    },
    "byom_result_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "external_link_ref": {
      "$ref": "#/$defs/identifier"
    },
    "acquired_at": {
      "$ref": "#/$defs/timestamp"
    },
    "released_at": {
      "$ref": "#/$defs/timestamp"
    },
    "digest": {
      "$ref": "#/$defs/digestRef"
    }
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "const": "released"
        }
      },
      "required": [
        "released_at"
      ],
      "$comment": "A released slot records when it released."
    },
    {
      "properties": {
        "state": {
          "enum": [
            "held",
            "submitting",
            "remote_unknown",
            "awaiting_principal",
            "byom_committed",
            "linking",
            "ambiguous"
          ]
        },
        "released_at": false
      },
      "$comment": "A held slot has no release time — timeout or point-in-time absence never releases (§16.3)."
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value_hex"
      ],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md §6.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md §6, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": {
              "const": "sha-256"
            }
          },
          "not": {
            "required": [
              "key_ref"
            ]
          }
        },
        {
          "properties": {
            "class": {
              "enum": [
                "local_erasure_safe",
                "scope_erasure_safe"
              ]
            },
            "algorithm": {
              "const": "hmac-sha-256"
            }
          },
          "required": [
            "key_ref"
          ]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    },
    "idempotencyDomainDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "key_ref",
        "value_hex"
      ],
      "properties": {
        "class": {
          "const": "scope_erasure_safe"
        },
        "algorithm": {
          "const": "hmac-sha-256"
        },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Per-Society index key id; the raw key is never part of the ref."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "description": "The IdempotencyDomain digest (§14.2; PROFILE.md §5, D-R0-1): always the keyed scope_erasure_safe class over the per-Society index key — a public class here is a conformance failure."
    }
  }
}
