{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byom.example/bpp/v0/governed-work/external-command-result-query-result.schema.json",
  "title": "ExternalCommandResultQueryResult — the five-fact union (DESIGN.md §16.3 verbatim; C2, R42)",
  "description": "The §16.3 result verbatim: the query returns exactly one of five facts, and the status-specific fields are closed. committed carries the retained signed KoveeEndeavorFormResult envelope (no second actor-only fetch). absent means only that a complete query of the live target domain currently contains neither a result nor a terminal tombstone — it does not prove an earlier request cannot arrive or commit later, and it never releases the Kovee slot. historically_fenced_absent means a complete RestoreLineageProof found no row and every predecessor execution domain is permanently fenced; its signed fence receipt proves the old command can no longer arrive (safe to release the slot, never relabelled as a tombstone that never existed). non_reexecuting_tombstone is a durable Byom-owned terminal claim over the exact IdempotencyDomain and command digest. unknown covers in-flight, incomplete-retention, unavailable, and unverifiable state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_digest",
    "current_endpoint_incarnation",
    "target_endpoint_incarnation",
    "idempotency_domain_digest",
    "status",
    "observed_at",
    "server_signature",
    "digest"
  ],
  "properties": {
    "query_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "current_endpoint_incarnation": {
      "$ref": "#/$defs/identifier"
    },
    "target_endpoint_incarnation": {
      "$ref": "#/$defs/identifier"
    },
    "idempotency_domain_digest": {
      "$ref": "#/$defs/idempotencyDomainDigest"
    },
    "status": {
      "enum": [
        "committed",
        "absent",
        "historically_fenced_absent",
        "non_reexecuting_tombstone",
        "unknown"
      ],
      "description": "§16.3 verbatim: exactly one of five facts."
    },
    "committed_result_envelope": {
      "$ref": "#/$defs/koveeEndeavorFormResult"
    },
    "committed_result_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "committed_result_signature": {
      "$ref": "#/$defs/signature"
    },
    "tombstone_ref": {
      "$ref": "#/$defs/identifier"
    },
    "tombstone_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "tombstone_reason": {
      "$ref": "#/$defs/reason"
    },
    "historical_fence_receipt_ref": {
      "$ref": "#/$defs/identifier"
    },
    "historical_fence_receipt_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "restore_lineage_evidence_ref": {
      "$ref": "#/$defs/identifier"
    },
    "restore_lineage_evidence_digest": {
      "$ref": "#/$defs/digestRef"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "server_signature": {
      "$ref": "#/$defs/signature"
    },
    "digest": {
      "$ref": "#/$defs/digestRef"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "committed"
        },
        "tombstone_ref": false,
        "tombstone_digest": false,
        "tombstone_reason": false,
        "historical_fence_receipt_ref": false,
        "historical_fence_receipt_digest": false
      },
      "required": [
        "committed_result_envelope",
        "committed_result_digest",
        "committed_result_signature"
      ],
      "$comment": "committed requires the result envelope/digest/signature and forbids tombstone/fence fields (§16.3)."
    },
    {
      "properties": {
        "status": {
          "const": "absent"
        },
        "committed_result_envelope": false,
        "committed_result_digest": false,
        "committed_result_signature": false,
        "tombstone_ref": false,
        "tombstone_digest": false,
        "tombstone_reason": false,
        "historical_fence_receipt_ref": false,
        "historical_fence_receipt_digest": false,
        "restore_lineage_evidence_ref": false,
        "restore_lineage_evidence_digest": false
      },
      "$comment": "Live absent forbids result, tombstone, historical-fence, and RestoreLineage fields (§16.3)."
    },
    {
      "properties": {
        "status": {
          "const": "historically_fenced_absent"
        },
        "committed_result_envelope": false,
        "committed_result_digest": false,
        "committed_result_signature": false,
        "tombstone_ref": false,
        "tombstone_digest": false,
        "tombstone_reason": false
      },
      "required": [
        "restore_lineage_evidence_ref",
        "restore_lineage_evidence_digest",
        "historical_fence_receipt_ref",
        "historical_fence_receipt_digest"
      ],
      "$comment": "historically_fenced_absent requires the exact RestoreLineage evidence and historical fence receipt and forbids result and tombstone fields (§16.3)."
    },
    {
      "properties": {
        "status": {
          "const": "non_reexecuting_tombstone"
        },
        "committed_result_envelope": false,
        "committed_result_digest": false,
        "committed_result_signature": false,
        "historical_fence_receipt_ref": false,
        "historical_fence_receipt_digest": false
      },
      "required": [
        "tombstone_ref",
        "tombstone_digest",
        "tombstone_reason"
      ],
      "$comment": "non_reexecuting_tombstone requires its ref/digest/reason and forbids result and historical-fence fields (§16.3)."
    },
    {
      "properties": {
        "status": {
          "const": "unknown"
        },
        "committed_result_envelope": false,
        "committed_result_digest": false,
        "committed_result_signature": false,
        "tombstone_ref": false,
        "tombstone_digest": false,
        "tombstone_reason": false,
        "historical_fence_receipt_ref": false,
        "historical_fence_receipt_digest": false
      },
      "$comment": "unknown forbids result/tombstone/fence fields but MAY carry non-authorizing diagnostic lineage evidence (§16.3)."
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque visible-ASCII identifier, at most 128 bytes (§14.9)."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§14.2 rejects unsafe integers)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC instant with Z offset. DESIGN.md does not fix a timestamp wire encoding; this derivation freezes with the bundle (gap note G3)."
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "value_hex"
      ],
      "$comment": "The closed family DigestRef wire (family-vectors/PROFILE.md §6.1, normative; D-R0-1): exactly the members {class, algorithm, key_ref?, value_hex}. The oneOf pins the closed class/algorithm pairing and requires key_ref exactly for the keyed erasure classes; each arm refines members of this already-closed object.",
      "properties": {
        "class": {
          "enum": [
            "structural_public",
            "portable_public",
            "local_erasure_safe",
            "scope_erasure_safe",
            "disclosed_party",
            "ciphertext_public"
          ],
          "description": "Digest class (PROFILE.md §6, D-R0-1); substituting one class where a schema requires another is a conformance failure."
        },
        "algorithm": {
          "enum": [
            "sha-256",
            "hmac-sha-256"
          ]
        },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Key id for the keyed erasure classes; raw HMAC keys, per-object secrets, and salts are never part of a DigestRef."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "oneOf": [
        {
          "properties": {
            "class": {
              "enum": [
                "structural_public",
                "portable_public",
                "disclosed_party",
                "ciphertext_public"
              ]
            },
            "algorithm": {
              "const": "sha-256"
            }
          },
          "not": {
            "required": [
              "key_ref"
            ]
          }
        },
        {
          "properties": {
            "class": {
              "enum": [
                "local_erasure_safe",
                "scope_erasure_safe"
              ]
            },
            "algorithm": {
              "const": "hmac-sha-256"
            }
          },
          "required": [
            "key_ref"
          ]
        }
      ],
      "description": "Typed DigestRef: every digest field is typed, never an unlabelled hash. Wire shape, class/algorithm pairing, and key_ref presence per the ratified family profile."
    },
    "idempotencyDomainDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "algorithm",
        "key_ref",
        "value_hex"
      ],
      "properties": {
        "class": {
          "const": "scope_erasure_safe"
        },
        "algorithm": {
          "const": "hmac-sha-256"
        },
        "key_ref": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$",
          "description": "Per-Society index key id; the raw key is never part of the ref."
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exactly 64 lowercase hex characters."
        }
      },
      "description": "The IdempotencyDomain digest (§14.2; PROFILE.md §5, D-R0-1): always the keyed scope_erasure_safe class over the per-Society index key — a public class here is a conformance failure."
    },
    "signature": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,4096}$",
      "description": "Detached signature envelope, opaque bounded visible-ASCII (algorithm suite is pinned by the endpoint identity material, §19)."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Short human-readable reason; free text, bounded."
    },
    "koveeEndeavorFormResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kovee_formation_intent_ref",
        "canonical_command_digest",
        "society_ref",
        "society_recovery_epoch",
        "idempotency_domain_digest",
        "endeavor_ref",
        "endeavor_revision",
        "endeavor_digest",
        "formation_decision_ref",
        "formation_slot_snapshot_digest",
        "source_cursor",
        "digest"
      ],
      "properties": {
        "kovee_formation_intent_ref": {
          "$ref": "#/$defs/identifier"
        },
        "canonical_command_digest": {
          "$ref": "#/$defs/digestRef"
        },
        "society_ref": {
          "$ref": "#/$defs/identifier"
        },
        "society_recovery_epoch": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "idempotency_domain_digest": {
          "$ref": "#/$defs/idempotencyDomainDigest"
        },
        "endeavor_ref": {
          "$ref": "#/$defs/identifier"
        },
        "endeavor_revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "endeavor_digest": {
          "$ref": "#/$defs/digestRef"
        },
        "formation_decision_ref": {
          "$ref": "#/$defs/identifier"
        },
        "formation_slot_snapshot_digest": {
          "$ref": "#/$defs/digestRef"
        },
        "source_cursor": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "$ref": "#/$defs/digestRef"
        }
      },
      "description": "KoveeEndeavorFormResult (§16.3 verbatim): the exact idempotent result — Position, immutable GovernanceDecision, active Endeavor, idempotency result, event/outbox set, and authority-journal transition committed as one visible atomic result."
    }
  }
}
